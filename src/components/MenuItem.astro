---
import { Flame, Star } from '@lucide/astro';

export interface Props {
  name: string;
  price: string;
  description: string;
  badge?: string | null;
  featured?: boolean;
  spicy?: boolean;
}

const { name, price, description, badge, featured = false, spicy = false } = Astro.props;
---

<article
  class:list={[
    'group relative rounded-2xl p-5 sm:p-6 transition-all duration-200 flex flex-col justify-between border',
    featured
      ? 'bg-gradient-to-br from-mizzou-slate800/95 to-mizzou-slate900 border-mizzou-gold/50 shadow-gold-glow'
      : 'bg-mizzou-slate900/90 border-white/10 hover:border-mizzou-gold/40',
  ]}
>
  <div>
    <!-- Top Badges -->
    {(badge || spicy) && (
      <div class="flex flex-wrap items-center gap-2 mb-2.5">
        {badge && (
          <span class="inline-flex items-center gap-1 bg-mizzou-gold text-mizzou-black text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
            <Star class="w-3 h-3 fill-current" />
            {badge}
          </span>
        )}
        {spicy && (
          <span class="inline-flex items-center gap-1 bg-red-500/20 text-red-300 border border-red-500/40 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
            <Flame class="w-3 h-3 text-red-400" />
            Spicy Kick
          </span>
        )}
      </div>
    )}

    <!-- Title & Price Row -->
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-xl font-bold uppercase tracking-wide text-white group-hover:text-mizzou-gold transition-colors">
        {name}
      </h3>
      <span class="font-display text-xl font-bold text-mizzou-gold shrink-0 bg-mizzou-black/70 border border-mizzou-gold/30 px-3 py-0.5 rounded-lg">
        {price}
      </span>
    </div>

    <!-- Description -->
    <p class="mt-2.5 text-sm text-gray-300 leading-relaxed">
      {description}
    </p>
  </div>
</article>
