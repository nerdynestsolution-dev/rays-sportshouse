---
import BaseLayout from '../layouts/BaseLayout.astro';
import specialsData from '../data/specials.json';
import {
  MapPin,
  Clock,
  CreditCard,
  Phone,
  Navigation,
  ShoppingBag,
  Tv,
  Car,
  CheckCircle2,
} from '@lucide/astro';
import Instagram from '../components/InstagramIcon.astro';

const { location, hours } = specialsData;
---

<BaseLayout
  title="Hours & Location | 1732 S 9th St, Soulard, St. Louis, MO 63104 | Ray's SportsHouse"
  description="Visit Ray's SportsHouse at 1732 S 9th St in historic Soulard, St. Louis, MO 63104. View our full weekly operating hours, interactive Google Map, directions, and payment options."
>
  <!-- PAGE HEADER -->
  <section class="relative bg-mizzou-black border-b border-mizzou-gold/30 py-12 sm:py-16">
    <div class="absolute inset-0 bg-tiger-stripe opacity-60 pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 bg-mizzou-gold/15 text-mizzou-gold border border-mizzou-gold/40 text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
            <MapPin class="w-3.5 h-3.5" /> Historic Soulard Neighborhood • St. Louis, MO
          </span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold uppercase text-white">
            Hours &amp; <span class="text-mizzou-gold">Location</span>
          </h1>
          <p class="text-gray-300 text-base sm:text-lg mt-3 max-w-2xl leading-relaxed">
            Located right on South 9th Street in historic Soulard — minutes from Busch Stadium, Enterprise Center, and Energizer Park.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={location.googleMapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-mizzou-gold hover:bg-mizzou-athletic text-mizzou-black font-display font-bold uppercase tracking-wider text-base px-6 py-3.5 rounded-xl shadow-gold-glow transition-all"
          >
            <Navigation class="w-5 h-5" />
            <span>Get Directions</span>
          </a>
          <a
            href={location.squareOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-mizzou-slate900 hover:bg-mizzou-slate800 text-white border border-mizzou-gold/50 font-display font-bold uppercase tracking-wider text-base px-6 py-3.5 rounded-xl transition-all"
          >
            <ShoppingBag class="w-5 h-5 text-mizzou-gold" />
            <span>Order Takeout</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT GRID: ADDRESS, HOURS TABLE, PAYMENT NOTICE & INTERACTIVE GOOGLE MAP -->
  <section class="py-12 sm:py-16 bg-mizzou-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Weekly Hours Table + Address + Payment & Social -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Address & Direct Contact Card -->
          <div class="rounded-2xl bg-mizzou-slate900 border-2 border-mizzou-gold/50 p-6 sm:p-8 shadow-gold-glow space-y-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-widest text-mizzou-gold">
                  Official Address
                </span>
                <h2 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white mt-1">
                  Ray's SportsHouse
                </h2>
                <p class="text-lg font-semibold text-gray-200 mt-1">
                  1732 S 9th St, St. Louis, MO 63104 <span class="text-mizzou-gold">(Soulard)</span>
                </p>
              </div>
              <div class="w-12 h-12 rounded-xl bg-mizzou-gold/15 border border-mizzou-gold/40 flex items-center justify-center text-mizzou-gold shrink-0">
                <MapPin class="w-6 h-6" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <a
                href={location.googleMapsDirectionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 bg-mizzou-gold hover:bg-mizzou-athletic text-mizzou-black font-display font-bold uppercase tracking-wider py-3 px-4 rounded-xl shadow-gold-glow transition-all"
              >
                <Navigation class="w-4 h-4" />
                <span>Get Directions</span>
              </a>
              <a
                href={location.phoneHref}
                class="flex items-center justify-center gap-2 bg-mizzou-black hover:bg-mizzou-slate800 text-white border border-white/15 font-display font-bold uppercase tracking-wider py-3 px-4 rounded-xl transition-all"
              >
                <Phone class="w-4 h-4 text-mizzou-gold" />
                <span>Call {location.phone}</span>
              </a>
            </div>
          </div>

          <!-- Full Weekly Operating Hours & Kitchen Hours Table -->
          <div class="rounded-2xl bg-mizzou-slate900 border border-white/15 p-6 sm:p-8 space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-mizzou-gold/15 border border-mizzou-gold/40 flex items-center justify-center text-mizzou-gold">
                <Clock class="w-5 h-5" />
              </div>
              <div>
                <h2 class="font-display text-2xl font-bold uppercase text-white">
                  Weekly Operating &amp; Kitchen Hours
                </h2>
                <p class="text-xs text-mizzou-gold font-bold uppercase tracking-wider">
                  Open 7 Days A Week in Historic Soulard
                </p>
              </div>
            </div>

            <!-- Dedicated Kitchen Hours Highlight Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="p-4 rounded-xl bg-mizzou-black/90 border border-mizzou-gold/40">
                <p class="text-[11px] font-extrabold uppercase tracking-widest text-mizzou-gold">
                  🍔 Kitchen Hours • Sun – Thu
                </p>
                <p class="font-display text-2xl font-bold uppercase text-white mt-1">
                  Sunday – Thursday: <span class="text-mizzou-gold">Until 9PM</span>
                </p>
              </div>
              <div class="p-4 rounded-xl bg-mizzou-black/90 border border-mizzou-gold/40">
                <p class="text-[11px] font-extrabold uppercase tracking-widest text-mizzou-gold">
                  🍔 Kitchen Hours • Fri – Sat
                </p>
                <p class="font-display text-2xl font-bold uppercase text-white mt-1">
                  Friday – Saturday: <span class="text-mizzou-gold">Until 11PM</span>
                </p>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-mizzou-gold/30 text-xs font-extrabold uppercase tracking-wider text-mizzou-gold">
                    <th class="py-3 pr-4">Day</th>
                    <th class="py-3 px-4">Bar Hours</th>
                    <th class="py-3 pl-4 text-right">Kitchen Hours</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10 text-sm">
                  {hours.map((row) => (
                    <tr class="hover:bg-white/5 transition-colors">
                      <td class="py-3.5 pr-4 font-bold text-white uppercase">{row.day}</td>
                      <td class="py-3.5 px-4 text-mizzou-gold font-semibold">{row.hours}</td>
                      <td class="py-3.5 pl-4 text-right text-gray-300">{row.kitchen}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-300">
              <span>🍺 <strong class="text-mizzou-gold">Happy Hour:</strong> Monday – Friday, 3:00 PM – 6:00 PM</span>
              <span>🍽️ <strong class="text-white">Kitchen Open:</strong> Sun–Thu Until 9PM • Fri–Sat Until 11PM</span>
            </div>
          </div>

          <!-- Payment Notice & Instagram Social Card -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-2xl bg-mizzou-slate900 border border-mizzou-gold/40 p-5 space-y-2.5">
              <div class="flex items-center gap-2 text-mizzou-gold font-display font-bold uppercase text-lg">
                <CreditCard class="w-5 h-5" />
                <span>Payment Options</span>
              </div>
              <p class="text-sm text-white font-medium leading-relaxed">
                We accept all major credit and debit cards, Apple Pay, and Google Pay.
              </p>
              <p class="text-xs text-gray-400">
                Visa • Mastercard • American Express • Discover • Contactless Tap &amp; Cash
              </p>
            </div>

            <div class="rounded-2xl bg-mizzou-slate900 border border-white/15 p-5 flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center gap-2 text-mizzou-gold font-display font-bold uppercase text-lg">
                  <Instagram class="w-5 h-5" />
                  <span>Connect on Social</span>
                </div>
                <p class="text-sm text-gray-300 mt-1">
                  Follow <strong class="text-white">{location.instagramHandle}</strong> for daily specials, TV game assignments, and watch party announcements.
                </p>
              </div>
              <a
                href={location.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-mizzou-gold hover:bg-mizzou-athletic text-mizzou-black font-display font-bold uppercase tracking-wider text-sm py-2.5 px-4 rounded-xl transition-all"
              >
                <Instagram class="w-4 h-4" />
                <span>Follow {location.instagramHandle}</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Google Map Iframe & Neighborhood Guide -->
        <div class="lg:col-span-6 space-y-6">
          <div class="rounded-2xl overflow-hidden border-2 border-mizzou-gold/50 shadow-gold-glow bg-mizzou-slate900 h-[440px] sm:h-[520px]">
            <iframe
              title="Ray's SportsHouse Soulard Map - 1732 S 9th St, St. Louis, MO 63104"
              src={location.googleMapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <!-- Neighborhood & Game Day Access Info -->
          <div class="rounded-2xl bg-mizzou-slate900 border border-white/15 p-6 space-y-4">
            <h3 class="font-display text-xl font-bold uppercase text-white flex items-center gap-2">
              <Car class="w-5 h-5 text-mizzou-gold" />
              <span>Getting Here &amp; Soulard Game Day Tips</span>
            </h3>
            <ul class="space-y-2.5 text-sm text-gray-300">
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-mizzou-gold shrink-0 mt-0.5" />
                <span><strong class="text-white">Easy Highway Access:</strong> Located just off I-55 &amp; I-44 on South 9th Street in Historic Soulard.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-mizzou-gold shrink-0 mt-0.5" />
                <span><strong class="text-white">Close to STL Stadiums:</strong> Less than 5 minutes south of Busch Stadium, Enterprise Center, and Energizer Park.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-mizzou-gold shrink-0 mt-0.5" />
                <span><strong class="text-white">Street Parking &amp; Rideshare:</strong> Free neighborhood street parking along S 9th St, Barton St, and Lami St, plus dedicated rideshare drop-off right out front.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
