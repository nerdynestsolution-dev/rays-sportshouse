---
import BaseLayout from '../layouts/BaseLayout.astro';
import specialsData from '../data/specials.json';
import { Flame, Clock, Beer, Utensils, Trophy, CheckCircle2, ShoppingBag, Calendar, Sparkles } from '@lucide/astro';

const { happyHour, gameDaySpecials, location } = specialsData;
---

<BaseLayout
  title="Specials & Happy Hour | $9.99 Lunch, Girl Dinner Wednesdays & NFL Deals | Ray's SportsHouse"
  description="Explore Ray's SportsHouse specials in Soulard, St. Louis: Mon–Fri Happy Hour (3PM–6PM), Tues–Fri $9.99 Lunch Special (11AM–2PM), Wednesday Girl Dinner ($13.99 + 1/2 Price Cocktails, Mocktails & Martinis), and NFL Game Day $9.99 1/4 LB Smash Burger & Fries."
>
  <!-- PAGE HEADER -->
  <section class="relative bg-mizzou-black border-b border-mizzou-gold/30 py-12 sm:py-16">
    <div class="absolute inset-0 bg-tiger-stripe opacity-60 pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 bg-mizzou-gold/15 text-mizzou-gold border border-mizzou-gold/40 text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
        <Flame class="w-3.5 h-3.5" /> Unbeatable Value in Historic Soulard
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold uppercase text-white">
        Happy Hour, Lunch &amp; <span class="text-mizzou-gold">Game Day Specials</span>
      </h1>
      <p class="text-gray-300 text-base sm:text-lg mt-3 max-w-3xl leading-relaxed">
        From our fast $9.99 Tues–Fri Lunch Special and Mon–Fri 3PM–6PM Happy Hour to Girl Dinner Wednesdays and $9.99 NFL Smash Burgers across 54+ HD screens.
      </p>
    </div>
  </section>

  <!-- FEATURED 3 PROMO CARDS FROM PHOTOS: NFL GAME DAY, WEDNESDAY GIRL DINNER, TUES-FRI LUNCH SPECIAL -->
  <section class="py-12 sm:py-16 bg-mizzou-black border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-widest text-mizzou-gold bg-mizzou-gold/10 border border-mizzou-gold/30 px-3 py-1 rounded-full mb-2">
          <Sparkles class="w-3.5 h-3.5" /> Weekly &amp; Game Day Headliners
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold uppercase text-white">
          Featured <span class="text-mizzou-gold">House Specials</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Card 1: Your House For Every NFL Game -->
        <article class="rounded-3xl bg-gradient-to-b from-emerald-950/80 via-mizzou-slate900 to-mizzou-black border-2 border-mizzou-gold p-6 sm:p-8 flex flex-col justify-between shadow-gold-glow">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="bg-mizzou-gold text-mizzou-black text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full">
                🏈 NFL Sunday Ticket + RedZone
              </span>
              <span class="font-display text-2xl font-bold bg-mizzou-gold text-mizzou-black px-3 py-0.5 rounded-lg">
                $9.99
              </span>
            </div>

            <h3 class="font-display text-3xl font-bold uppercase text-white leading-tight">
              Your House For <span class="text-mizzou-gold">Every NFL Game.</span>
            </h3>
            <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-300 mt-1">
              Every NFL Broadcast • 54+ HD Screens
            </p>

            <div class="mt-5 space-y-3">
              <div class="p-4 rounded-2xl bg-mizzou-black/80 border border-mizzou-gold/40 flex items-center justify-between gap-3">
                <div>
                  <p class="font-display text-xl font-bold uppercase text-white">
                    1/4 LB Smash Burger &amp; Fries
                  </p>
                  <p class="text-xs text-gray-300">Served hot during every NFL game</p>
                </div>
                <span class="font-display text-3xl font-bold text-mizzou-gold shrink-0">$9.99</span>
              </div>

              <div class="p-4 rounded-2xl bg-mizzou-black/80 border border-white/15 flex items-center justify-between gap-3">
                <div>
                  <p class="font-display text-xl font-bold uppercase text-white">
                    Draft Specials
                  </p>
                  <p class="text-xs text-gray-300">Featuring ice-cold Busch Light &amp; more</p>
                </div>
                <div class="text-right shrink-0">
                  <span class="block text-[10px] uppercase tracking-wider text-gray-400 font-bold">Starting At</span>
                  <span class="font-display text-3xl font-bold text-mizzou-gold">$3.99</span>
                </div>
              </div>
            </div>
          </div>

          <p class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-300 font-semibold">
            📺 Official NFL Sunday Ticket &amp; NFL RedZone Headquarters
          </p>
        </article>

        <!-- Card 2: Girl Dinner Every Wednesday 6PM - Close -->
        <article class="rounded-3xl bg-gradient-to-b from-mizzou-slate800 via-mizzou-slate900 to-mizzou-black border-2 border-mizzou-gold p-6 sm:p-8 flex flex-col justify-between shadow-gold-glow">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="bg-mizzou-gold text-mizzou-black text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full">
                🍸 Every Wednesday
              </span>
              <span class="text-xs font-extrabold uppercase tracking-wider bg-mizzou-black text-mizzou-gold border border-mizzou-gold/40 px-3 py-1 rounded-lg">
                6PM – Close
              </span>
            </div>

            <h3 class="font-display text-3xl font-bold uppercase text-white leading-tight">
              Girl <span class="text-mizzou-gold">Dinner</span> Wednesdays
            </h3>
            <p class="text-xs font-extrabold uppercase tracking-wider text-mizzou-gold mt-1">
              Every Wednesday | 6:00 PM – Close
            </p>

            <div class="mt-5 space-y-3">
              <div class="p-4 rounded-2xl bg-mizzou-black/80 border border-mizzou-gold/40 flex items-center justify-between gap-3">
                <div>
                  <p class="font-display text-xl font-bold uppercase text-white">
                    The Girl Dinner Platter
                  </p>
                  <p class="text-xs text-gray-300">
                    Crispy chicken tenders, seasoned fries, Caesar salad &amp; dipping sauce
                  </p>
                </div>
                <span class="font-display text-3xl font-bold text-mizzou-gold shrink-0">$13.99</span>
              </div>

              <div class="p-4 rounded-2xl bg-mizzou-black/80 border border-white/15">
                <div class="flex items-center justify-between gap-2">
                  <p class="font-display text-2xl font-bold uppercase text-mizzou-gold">
                    1/2 PRICE DRINKS
                  </p>
                  <span class="bg-mizzou-gold/20 text-mizzou-gold border border-mizzou-gold/40 text-xs font-extrabold uppercase px-2.5 py-0.5 rounded">
                    50% Off
                  </span>
                </div>
                <p class="text-sm text-white font-semibold mt-1">
                  Specialty Cocktails, Mocktails, &amp; Martinis
                </p>
              </div>
            </div>
          </div>

          <p class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-300 font-semibold">
            ✨ Half-price Sarti Spritz, Mom's Weekend, M-I-Z Bloom, Espresso Martinis &amp; Mocktails!
          </p>
        </article>

        <!-- Card 3: Lunch Special Every Tues-Fri 11AM-2PM -->
        <article class="rounded-3xl bg-gradient-to-b from-mizzou-slate800 via-mizzou-slate900 to-mizzou-black border-2 border-mizzou-gold p-6 sm:p-8 flex flex-col justify-between shadow-gold-glow">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="bg-mizzou-gold text-mizzou-black text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full">
                🍽️ Every Tues–Fri
              </span>
              <span class="text-xs font-extrabold uppercase tracking-wider bg-mizzou-black text-mizzou-gold border border-mizzou-gold/40 px-3 py-1 rounded-lg">
                11AM – 2PM
              </span>
            </div>

            <h3 class="font-display text-3xl font-bold uppercase text-white leading-tight">
              Weekday <span class="text-mizzou-gold">Lunch Special!</span>
            </h3>
            <p class="text-xs font-extrabold uppercase tracking-wider text-mizzou-gold mt-1">
              Built to level up your lunch break — in &amp; out in under 25 minutes!
            </p>

            <div class="mt-5 space-y-2.5">
              <div class="p-3.5 rounded-2xl bg-mizzou-black/80 border border-mizzou-gold/40 flex items-center justify-between gap-3">
                <span class="font-display text-lg font-bold uppercase text-white">
                  Select Lunch Items
                </span>
                <span class="font-display text-2xl font-bold text-mizzou-gold">$9.99</span>
              </div>

              <div class="p-3.5 rounded-2xl bg-mizzou-black/80 border border-white/15 flex items-center justify-between gap-3">
                <span class="font-display text-lg font-bold uppercase text-white">
                  Domestic Beers
                </span>
                <span class="font-display text-2xl font-bold text-mizzou-gold">$2.99</span>
              </div>

              <div class="p-3.5 rounded-2xl bg-mizzou-black/80 border border-white/15 flex items-center justify-between gap-3">
                <div>
                  <p class="font-display text-lg font-bold uppercase text-white">
                    Rail Liquor &amp; Select Shots
                  </p>
                  <p class="text-xs text-gray-300">Including Fireball &amp; house favorites!</p>
                </div>
                <span class="font-display text-2xl font-bold text-mizzou-gold">$3.99</span>
              </div>
            </div>
          </div>

          <p class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-300 font-semibold">
            ⚡ Lunch plans = handled. Available Tuesday–Friday, 11AM–2PM.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHT BANNER: MONDAY - FRIDAY HAPPY HOUR (3PM UNTIL 6PM) -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-mizzou-slate900 to-mizzou-black border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-br from-mizzou-slate800 via-mizzou-slate900 to-mizzou-black border-2 border-mizzou-gold p-6 sm:p-10 shadow-gold-glow">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-white/15">
          <div>
            <span class="inline-flex items-center gap-2 bg-mizzou-gold text-mizzou-black font-extrabold uppercase tracking-widest text-xs px-3.5 py-1.5 rounded-full mb-3">
              <Clock class="w-4 h-4" /> Happy Hour @ Ray's SportsHouse
            </span>
            <h2 class="font-display text-3xl sm:text-5xl font-bold uppercase text-white">
              Monday – Friday | <span class="text-mizzou-gold">3:00 PM Until 6:00 PM</span>
            </h2>
            <p class="text-gray-300 text-sm sm:text-base mt-2 max-w-2xl">
              {happyHour.subtitle}
            </p>
          </div>
          <div class="shrink-0">
            <a
              href="/hours-location"
              class="inline-flex items-center gap-2 bg-mizzou-gold hover:bg-mizzou-athletic text-mizzou-black font-display font-bold uppercase tracking-wider px-6 py-3.5 rounded-xl shadow-gold-glow transition-all"
            >
              <span>Visit Us at 1732 S 9th St</span>
            </a>
          </div>
        </div>

        <!-- Drink Specials & $7.99 Food Specials Grid -->
        <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Left: Drink Specials (7 cols) -->
          <div class="lg:col-span-7 bg-mizzou-black/70 border border-white/10 rounded-2xl p-6">
            <div class="flex items-center gap-2.5 mb-5">
              <div class="w-10 h-10 rounded-xl bg-mizzou-gold/15 border border-mizzou-gold/40 flex items-center justify-center text-mizzou-gold">
                <Beer class="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-display text-2xl font-bold uppercase text-white">
                  Happy Hour Drink Specials
                </h3>
                <p class="text-xs text-mizzou-gold font-semibold uppercase tracking-wider">
                  Monday – Friday • 3PM Until 6PM
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Bottled Beer $3.59 -->
              <div class="p-4 rounded-xl bg-mizzou-slate900/90 border border-mizzou-gold/30 sm:col-span-2">
                <div class="flex items-center justify-between gap-2">
                  <h4 class="font-display text-xl font-bold uppercase text-mizzou-gold">
                    Bottled Beer
                  </h4>
                  <span class="font-display text-2xl font-bold text-mizzou-gold bg-mizzou-black px-3 py-0.5 rounded-lg border border-mizzou-gold/40">
                    $3.59
                  </span>
                </div>
                <div class="mt-2.5 flex flex-wrap gap-2">
                  {['Yuengling Flight', 'Coors Light', 'Yuengling Lager', 'Miller High Life', 'Natural Light (16 oz)'].map((beer) => (
                    <span class="bg-mizzou-black text-white border border-white/15 text-xs font-semibold px-3 py-1 rounded-lg">
                      {beer}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Draft Beer -->
              <div class="p-4 rounded-xl bg-mizzou-slate900/90 border border-white/10">
                <h4 class="font-display text-xl font-bold uppercase text-mizzou-gold mb-2">
                  Draft Beer
                </h4>
                <ul class="space-y-1.5 text-sm text-white font-semibold">
                  <li class="flex justify-between">
                    <span>Modelo</span>
                    <span class="text-mizzou-gold font-display text-lg">$5.59</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Busch Light</span>
                    <span class="text-mizzou-gold font-display text-lg">$4.59</span>
                  </li>
                </ul>
              </div>

              <!-- Rail Liquor -->
              <div class="p-4 rounded-xl bg-mizzou-slate900/90 border border-white/10 flex flex-col justify-between">
                <div>
                  <h4 class="font-display text-xl font-bold uppercase text-mizzou-gold">
                    Rail Liquor
                  </h4>
                  <p class="text-xs text-gray-300 mt-1">House rail spirits &amp; mixers</p>
                </div>
                <p class="font-display text-3xl font-bold text-white mt-3">$4.59</p>
              </div>

              <!-- Select Specialty Shots -->
              <div class="p-4 rounded-xl bg-mizzou-slate900/90 border border-white/10 flex items-center justify-between gap-3">
                <div>
                  <h4 class="font-display text-lg font-bold uppercase text-mizzou-gold">
                    Select Specialty Shots
                  </h4>
                  <p class="text-xs text-gray-300 mt-0.5">Bartender's featured lineup</p>
                </div>
                <span class="font-display text-2xl font-bold text-mizzou-gold bg-mizzou-black px-3 py-1 rounded-lg border border-mizzou-gold/40">
                  $3.99
                </span>
              </div>

              <!-- Redbull House Bomb -->
              <div class="p-4 rounded-xl bg-mizzou-slate900/90 border border-white/10 flex items-center justify-between gap-3">
                <div>
                  <h4 class="font-display text-lg font-bold uppercase text-mizzou-gold">
                    Redbull House Bomb
                  </h4>
                  <p class="text-xs text-gray-300 mt-0.5">House energy bomb special</p>
                </div>
                <span class="font-display text-2xl font-bold text-mizzou-gold bg-mizzou-black px-3 py-1 rounded-lg border border-mizzou-gold/40">
                  $4.99
                </span>
              </div>
            </div>
          </div>

          <!-- Right: Happy Hour Food $7.99 (5 cols) -->
          <div class="lg:col-span-5 bg-mizzou-black/70 border border-mizzou-gold/40 rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2.5 mb-5">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-mizzou-gold/15 border border-mizzou-gold/40 flex items-center justify-center text-mizzou-gold">
                    <Utensils class="w-5 h-5" />
                  </div>
                  <div>
                    <h3 class="font-display text-2xl font-bold uppercase text-white">
                      Happy Hour Food
                    </h3>
                    <p class="text-xs text-mizzou-gold font-semibold uppercase tracking-wider">
                      Monday – Friday • 3PM Until 6PM
                    </p>
                  </div>
                </div>
                <span class="font-display text-3xl font-bold bg-mizzou-gold text-mizzou-black px-3.5 py-1 rounded-xl shadow-gold-glow">
                  $7.99
                </span>
              </div>

              <ul class="space-y-4">
                {happyHour.foodDeals.map((food) => (
                  <li class="p-4 rounded-xl bg-mizzou-slate900/95 border border-white/15 flex items-center justify-between gap-4">
                    <div>
                      <p class="font-display text-xl font-bold uppercase text-white">
                        {food.item}
                      </p>
                      <p class="text-xs text-gray-400 mt-0.5">
                        {food.detail}
                      </p>
                    </div>
                    <span class="font-display text-2xl font-bold text-mizzou-gold bg-mizzou-black px-3.5 py-1 rounded-lg border border-mizzou-gold/40 shrink-0">
                      {food.price}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-300 flex items-center justify-between">
              <span>📍 Dine-In Happy Hour at 1732 S 9th St</span>
              <a href="/menu" class="text-mizzou-gold font-bold hover:underline">
                Full Menu →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL WEEKLY & GAME DAY SPECIALS OVERVIEW GRID -->
  <section class="py-16 bg-mizzou-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-widest text-mizzou-gold bg-mizzou-gold/10 border border-mizzou-gold/30 px-3 py-1 rounded-full mb-3">
          <Trophy class="w-3.5 h-3.5" /> Complete Lineup
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold uppercase text-white">
          All Specials <span class="text-mizzou-gold">At A Glance</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {gameDaySpecials.map((special) => (
          <article class="rounded-2xl bg-mizzou-slate900 border border-mizzou-gold/40 p-6 sm:p-8 flex flex-col justify-between shadow-gold-glow">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <span class="bg-mizzou-gold text-mizzou-black text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full">
                  {special.badge}
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-gray-300 bg-mizzou-black px-3 py-1 rounded-lg border border-white/10">
                  <Calendar class="w-3.5 h-3.5 text-mizzou-gold" />
                  {special.day}
                </span>
              </div>

              <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white">
                {special.title}
              </h3>
              <p class="text-xs font-bold uppercase tracking-wider text-mizzou-gold mt-1">
                {special.timing}
              </p>
              <p class="text-sm text-gray-300 mt-3 leading-relaxed">
                {special.description}
              </p>

              <ul class="mt-5 pt-5 border-t border-white/10 space-y-2.5">
                {special.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-white font-medium">
                    <CheckCircle2 class="w-4 h-4 text-mizzou-gold shrink-0 mt-0.5" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
              <a
                href="/events"
                class="text-xs font-extrabold uppercase tracking-wider text-mizzou-gold hover:underline"
              >
                View Watch Party Schedule →
              </a>
              <a
                href={location.squareOrderUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 bg-mizzou-gold hover:bg-mizzou-athletic text-mizzou-black font-display font-bold uppercase tracking-wider text-xs px-4 py-2 rounded-lg transition-all"
              >
                <ShoppingBag class="w-3.5 h-3.5" />
                <span>Order Online</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
